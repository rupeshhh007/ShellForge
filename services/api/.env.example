# Comma-separated exact browser origins; wildcards are rejected.
SHELLFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional, explicit model serving only; leave unset for the default product.
# SHELLFORGE_MODEL_ADAPTER=/absolute/path/to/verified/final-adapter

# Optional reviewed-question selector; both values are required to permit any requests.
# Set the key directly in the Render environment, never in browser variables or Git.
# GEMINI_API_KEY=
# SHELLFORGE_TUTOR_BUDGET=0
# Budget is 0–20 outbound requests per process lifetime; it resets on restart.
# Uses gemini-3.5-flash-lite, at most 2 requests/minute, one active request.
